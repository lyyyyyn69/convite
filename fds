    const ticketSummaryEl = document.getElementById('ticket-summary');
    const copyBtn = document.getElementById('copy-btn');
    const whatsappConfirmBtn = document.getElementById('whatsapp-confirm-btn');

    // Atualiza campos de nomes conforme quantidade de acompanhantes (0 a 5)
    companionsSelect.addEventListener('change', () => {
      const count = parseInt(companionsSelect.value, 10);
      companionsInputs.innerHTML = '';

      if (count > 0) {
        companionsWrapper.style.display = 'block';
        for (let i = 1; i <= count; i++) {
          const input = document.createElement('input');
          input.type = 'text';
          input.required = true;
          input.placeholder = `Nome do acompanhante ${i}`;
          input.className = 'companion-name-input';
          companionsInputs.appendChild(input);
        }
      } else {
        companionsWrapper.style.display = 'none';
      }
    });

    // Gera código exclusivo alfanumérico
    function generateInviteCode(name) {
      const cleanPrefix = name
        .trim()
        .toUpperCase()
        .replace(/[^A-Z]/g, '')
        .slice(0, 3)
        .padEnd(3, 'X');
      const randomNum = Math.floor(1000 + Math.random() * 9000);
      return `VIT12-${cleanPrefix}-${randomNum}`;
    }

    // Submissão do formulário
    rsvpForm.addEventListener('submit', (e) => {
      e.preventDefault();

      const guestName = document.getElementById('guest-name').value.trim();
      const count = parseInt(companionsSelect.value, 10);
      const companionInputs = document.querySelectorAll('.companion-name-input');
      const companionsList = Array.from(companionInputs).map(inp => inp.value.trim());

      const code = generateInviteCode(guestName);
      const totalPeople = 1 + count;

      generatedCodeEl.textContent = code;

      let summaryHTML = `<strong>Convidado(a) Principal:</strong> ${guestName}<br>`;
      summaryHTML += `<strong>Total de Pessoas:</strong> ${totalPeople} (${count} acompanhante${count === 1 ? '' : 's'})`;
      if (companionsList.length > 0) {
        summaryHTML += `<br><strong>Acompanhantes:</strong> ${companionsList.join(', ')}`;
      }
      ticketSummaryEl.innerHTML = summaryHTML;

      // Monta link do WhatsApp para enviar o código aos pais da Vitória
      const parentPhone = '5511999991313'; // Número da mãe da Vitória
      let msg = `🎃 *Confirmação de Presença - 12 Anos da Vitória* 🎃\n\n`;
      msg += `*Nome:* ${guestName}\n`;
      msg += `*Acompanhantes:* ${count}\n`;
      if (companionsList.length > 0) {
        msg += `*Nomes:* ${companionsList.join(', ')}\n`;
      }
      msg += `*Código do Convite:* ${code}`;

      whatsappConfirmBtn.href = `https://wa.me/${parentPhone}?text=${encodeURIComponent(msg)}`;

      // Exibe o passe gerado
      ticketArea.style.display = 'block';
      ticketArea.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // Botão de copiar código
    copyBtn.addEventListener('click', () => {
      const codeText = generatedCodeEl.textContent;
      navigator.clipboard.writeText(codeText).then(() => {
        const originalText = copyBtn.textContent;
        copyBtn.textContent = '✅ Código Copiado!';
        setTimeout(() => {
          copyBtn.textContent = originalText;
        }, 2200);
      });
    });
  </script>
</body>
</html>
