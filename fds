<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vitória • 12 Anos • Sexta-Feira 13</title>
  <!-- Fontes temáticas do Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Creepster&family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-black: #09060e;
      --bg-card: #140d21;
      --bg-card-alt: #1c122e;
      --purple-main: #7b2cbf;
      --purple-light: #9d4edd;
      --purple-glow: rgba(157, 78, 221, 0.45);
      --green-neon: #39ff14;
      --green-dark: #1f9d08;
      --green-glow: rgba(57, 255, 20, 0.35);
      --text-light: #f3efff;
      --text-muted: #b8aed4;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-black);
      background-image: 
        radial-gradient(circle at 15% 20%, rgba(123, 44, 191, 0.22) 0%, transparent 40%),
        radial-gradient(circle at 85% 75%, rgba(57, 255, 20, 0.12) 0%, transparent 45%);
      color: var(--text-light);
      font-family: 'Poppins', sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
      padding-bottom: 50px;
    }

    /* Teias de Aranha nos Cantos Superiores */
    .cobweb {
      position: fixed;
      top: 0;
      width: 180px;
      height: 180px;
      pointer-events: none;
      z-index: 1;
      opacity: 0.35;
    }
    .cobweb.left { left: 0; }
    .cobweb.right { right: 0; transform: scaleX(-1); }

    /* Morcegos Flutuantes */
    .floating-bats {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }
    .bat {
      position: absolute;
      width: 36px;
      fill: var(--purple-light);
      opacity: 0.35;
      animation: fly 14s infinite ease-in-out;
    }
    .bat:nth-child(1) { top: 12%; left: 10%; animation-delay: 0s; }
    .bat:nth-child(2) { top: 28%; right: 12%; width: 45px; animation-delay: 3s; }
    .bat:nth-child(3) { top: 65%; left: 8%; width: 28px; animation-delay: 6s; }
    .bat:nth-child(4) { top: 75%; right: 15%; width: 38px; animation-delay: 9s; }

    @keyframes fly {
      0%, 100% { transform: translateY(0) rotate(-4deg); }
      50% { transform: translateY(-22px) rotate(6deg); }
    }

    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    /* Container Principal */
    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 30px 18px;
      position: relative;
      z-index: 2;
    }

    /* Cabeçalho / Hero */
    header {
      text-align: center;
      padding: 35px 20px;
      background: linear-gradient(180deg, rgba(28, 18, 46, 0.9) 0%, rgba(14, 9, 24, 0.95) 100%);
      border: 2px solid var(--purple-main);
      border-radius: 24px;
      box-shadow: 0 0 30px var(--purple-glow), inset 0 0 20px rgba(57, 255, 20, 0.08);
      position: relative;
      margin-bottom: 28px;
    }

    .badge-date {
      display: inline-block;
      background: rgba(57, 255, 20, 0.14);
      border: 1px solid var(--green-neon);
      color: var(--green-neon);
      padding: 6px 18px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      box-shadow: 0 0 12px var(--green-glow);
      margin-bottom: 14px;
    }

    .hero-illustration {
      width: 110px;
      height: 110px;
      margin: 0 auto 10px;
      animation: floatSlow 3.5s infinite ease-in-out;
    }

    h1 {
      font-family: 'Creepster', cursive;
      font-size: clamp(2.8rem, 7vw, 4.3rem);
      color: var(--green-neon);
      text-shadow: 0 0 15px var(--green-glow), 3px 3px 0px var(--purple-main);
      letter-spacing: 2px;
      line-height: 1.05;
      margin-bottom: 8px;
    }

    .subtitle {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-light);
      margin-bottom: 14px;
    }

    .subtitle span {
      color: var(--purple-light);
      font-weight: 700;
    }

    .intro-text {
      color: var(--text-muted);
      font-size: 0.98rem;
      max-width: 540px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Seções em Cards */
    .card {
      background: var(--bg-card);
      border: 1px solid rgba(157, 78, 221, 0.45);
      border-radius: 20px;
      padding: 26px 22px;
      margin-bottom: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
      position: relative;
    }

    .card-title {
      font-family: 'Creepster', cursive;
      font-size: 1.9rem;
      color: var(--purple-light);
      letter-spacing: 1.5px;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px dashed rgba(57, 255, 20, 0.3);
      padding-bottom: 10px;
    }

    .card-title svg {
      width: 28px;
      height: 28px;
      flex-shrink: 0;
    }

    /* Grid de Informações */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }

    .info-box {
      background: var(--bg-card-alt);
      border-left: 4px solid var(--green-neon);
      padding: 15px;
      border-radius: 12px;
    }

    .info-box h3 {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--green-neon);
      margin-bottom: 6px;
    }

    .info-box p {
      font-size: 0.98rem;
      color: var(--text-light);
      line-height: 1.5;
    }

    .btn-map {
      display: inline-block;
      margin-top: 10px;
      padding: 7px 14px;
      background: rgba(123, 44, 191, 0.3);
      border: 1px solid var(--purple-light);
      color: var(--text-light);
      text-decoration: none;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 600;
      transition: 0.25s;
    }

    .btn-map:hover {
      background: var(--purple-main);
      box-shadow: 0 0 12px var(--purple-glow);
    }

    /* Contatos dos Pais */
    .parents-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
    }

    .parent-card {
      background: var(--bg-card-alt);
      border: 1px solid rgba(157, 78, 221, 0.3);
      border-radius: 14px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 10px;
    }

    .parent-name {
      font-weight: 600;
      font-size: 1rem;
      color: var(--text-light);
    }

    .parent-role {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .btn-whats {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: rgba(57, 255, 20, 0.15);
      border: 1px solid var(--green-neon);
      color: var(--green-neon);
      text-decoration: none;
      padding: 8px 12px;
      border-radius: 10px;
      font-size: 0.88rem;
      font-weight: 600;
      transition: 0.25s;
    }

    .btn-whats:hover {
      background: var(--green-neon);
      color: #050505;
      box-shadow: 0 0 15px var(--green-glow);
    }

    /* Formulário RSVP */
    .form-group {
      margin-bottom: 16px;
    }

    label {
      display: block;
      font-size: 0.92rem;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--text-light);
    }

    input[type="text"],
    select {
      width: 100%;
      padding: 12px 14px;
      background: #0c0714;
      border: 1.5px solid var(--purple-main);
      border-radius: 12px;
      color: var(--text-light);
      font-family: 'Poppins', sans-serif;
      font-size: 0.95rem;
      outline: none;
      transition: 0.25s;
    }

    input[type="text"]:focus,
    select:focus {
      border-color: var(--green-neon);
      box-shadow: 0 0 12px var(--green-glow);
    }

    .companions-container {
      display: grid;
      gap: 10px;
      margin-top: 10px;
    }

    .btn-submit {
      width: 100%;
      padding: 14px;
      margin-top: 8px;
      background: linear-gradient(90deg, var(--purple-main), #5a189a);
      border: 2px solid var(--green-neon);
      border-radius: 14px;
      color: var(--green-neon);
      font-family: 'Creepster', cursive;
      font-size: 1.65rem;
      letter-spacing: 1.5px;
      cursor: pointer;
      transition: 0.3s;
      box-shadow: 0 0 18px var(--purple-glow);
    }

    .btn-submit:hover {
      background: var(--green-neon);
      color: #09060e;
      box-shadow: 0 0 25px var(--green-glow);
      transform: translateY(-2px);
    }

    /* Ticket / Código de Convite Gerado */
    #ticket-area {
      display: none;
      margin-top: 24px;
      background: linear-gradient(135deg, #1b0f30 0%, #0d0817 100%);
      border: 2px dashed var(--green-neon);
      border-radius: 18px;
      padding: 22px;
      text-align: center;
      box-shadow: 0 0 25px rgba(57, 255, 20, 0.22);
      animation: fadeIn 0.5s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }

    .ticket-header {
      font-family: 'Creepster', cursive;
      font-size: 1.7rem;
      color: var(--green-neon);
      letter-spacing: 1px;
      margin-bottom: 6px;
    }

    .ticket-code-box {
      background: #07040c;
      border: 1px solid var(--purple-light);
      padding: 12px 18px;
      border-radius: 12px;
      margin: 14px auto;
      display: inline-block;
    }

    .ticket-code-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      color: var(--text-muted);
      letter-spacing: 1px;
    }

    .ticket-code {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--green-neon);
      letter-spacing: 3px;
      font-family: monospace;
    }

    .ticket-details {
      font-size: 0.9rem;
      color: var(--text-light);
      margin-bottom: 14px;
      line-height: 1.6;
    }

    .ticket-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
    }

    .btn-copy, .btn-send-parents {
      padding: 10px 16px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.88rem;
      cursor: pointer;
      border: none;
      text-decoration: none;
      transition: 0.25s;
    }

    .btn-copy {
      background: var(--purple-main);
      color: #fff;
    }

    .btn-copy:hover {
      background: var(--purple-light);
    }

    .btn-send-parents {
      background: var(--green-neon);
      color: #09060e;
    }

    .btn-send-parents:hover {
      filter: brightness(1.1);
    }

    /* Rodapé */
    footer {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
      margin-top: 20px;
    }

    footer span {
      color: var(--green-neon);
    }
  </style>
</head>
